# Enforce Unix LF line endings across all text and shell artifacts
* text=auto eol=lf
*.sh text eol=lf
*.1 text eol=lf
Makefile text eol=lf

# Ensure GitHub Linguist classifies the repository as 100% Shell
Makefile linguist-detectable=false
.markdownlint.json linguist-detectable=false
man/* linguist-documentation=true
docs/* linguist-documentation=true

# Exclude development, CI metadata, and tests from release tarballs
.github/ export-ignore
tests/ export-ignore
docs/ export-ignore
.editorconfig export-ignore
.gitattributes export-ignore
.gitignore export-ignore
.shellcheckrc export-ignore
.markdownlint.json export-ignore
install.sh export-ignore
