# Enforce Unix LF line endings across all text and shell artifacts
* text=auto eol=lf
*.sh text eol=lf
Makefile text eol=lf

# Ensure GitHub Linguist classifies the repository as 100% Shell
Makefile linguist-detectable=false

# Exclude development and CI metadata from release archive tarballs
.github/ export-ignore
.editorconfig export-ignore
.gitattributes export-ignore
.gitignore export-ignore
.shellcheckrc export-ignore
